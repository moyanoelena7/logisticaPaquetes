{
  "info": {
    "name": "Logistica Paquetes - Flujo Completo Postman",
    "description": "Flujo de negocio end-to-end. Ejecutar el setup una sola vez por juego de datos; el proceso principal requiere informar resultado para los seis paquetes antes del cierre. El contrato interno tiene una colección separada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Autenticación y Salud",
      "item": [
        {
          "name": "Health - API Gateway (8080)",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/actuator/health"
          }
        },
        {
          "name": "Health - ms-paquetes (8081)",
          "request": {
            "method": "GET",
            "url": "{{ms_paquetes_url}}/actuator/health"
          }
        },
        {
          "name": "Health - ms-logistica (8082)",
          "request": {
            "method": "GET",
            "url": "{{ms_logistica_url}}/actuator/health"
          }
        },
        {
          "name": "Token - Administrador (admin.logistica)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('admin_token', json.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "logistica-api"
                },
                {
                  "key": "username",
                  "value": "{{admin_username}}"
                },
                {
                  "key": "password",
                  "value": "{{admin_password}}"
                }
              ]
            },
            "url": "{{keycloak_token_url}}"
          }
        },
        {
          "name": "Token - Repartidor (usuario del entorno + extrae sub)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('repartidor_token', json.access_token);",
                  "const payload = JSON.parse(atob(json.access_token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.environment.set('repartidor_sub', payload.sub);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "logistica-api"
                },
                {
                  "key": "username",
                  "value": "{{repartidor_username}}"
                },
                {
                  "key": "password",
                  "value": "{{repartidor_password}}"
                }
              ]
            },
            "url": "{{keycloak_token_url}}"
          }
        }
      ],
      "description": "Ejecutar los tokens de administrador y repartidor. El token técnico solo se usa en la colección separada del contrato interno."
    },
