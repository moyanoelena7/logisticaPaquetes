                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03.7 Registrar Incidencia Paquete 2 (Repartidor Asignado)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{repartidor_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resultado\": \"INCIDENCIA\",\n  \"motivoIncidencia\": \"Domicilio cerrado sin moradores\"\n}"
            },
            "url": "{{gateway_url}}/envios/{{id_envio}}/paquetes/{{id_paquete_2}}/resultado"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03.9 Registrar Entrega Paquete 3",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{gateway_url}}/envios/{{id_envio}}/paquetes/{{id_paquete_3}}/resultado",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{repartidor_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"resultado\":\"ENTREGADO\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "description": "Registra el resultado de este paquete; hace falta informar el resultado de todos antes del cierre."
