    {
      "name": "03 - Proceso Principal MVP (ms-logistica)",
      "item": [
        {
          "name": "03.1 Crear Borrador Envio (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  pm.environment.set('id_envio', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sucursalId\": {{id_sucursal}},\n  \"sector\": \"CENTRAL\",\n  \"paqueteIds\": [{{id_paquete_1}}, {{id_paquete_2}}, {{id_paquete_3}}, {{id_paquete_4}}, {{id_paquete_5}}, {{id_paquete_6}}]\n}"
            },
            "url": "{{gateway_url}}/envios"
          }
        },
        {
          "name": "03.2 Asignar Recursos al Envio (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiculoId\": {{id_vehiculo_grande}},\n  \"repartidorId\": {{id_repartidor}}\n}"
            },
            "url": "{{gateway_url}}/envios/{{id_envio}}/asignaciones"
          }
        },
        {
          "name": "03.3 Calcular y Guardar Ruta con OSRM (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": "{{gateway_url}}/envios/{{id_envio}}/ruta"
          }
        },
        {
          "name": "03.4 Consultar Ruta del Envio (Repartidor Asignado)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{repartidor_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{gateway_url}}/envios/{{id_envio}}/ruta"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "const paradas = body.paradas || [];",
                  "pm.test('La ruta tiene seis paquetes', function () { pm.expect(paradas.length).to.eql(6); });",
                  "paradas.forEach(function (parada, index) { pm.environment.set('id_paquete_' + (index + 1), parada.paqueteId); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03.8 Consultar Mis Rutas (Repartidor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/envios/mias/rutas",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{repartidor_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });\nconst envioId = String(pm.environment.get('id_envio'));\nconst rutas = pm.response.json();\npm.test('El envío aparece entre mis rutas', function () { pm.expect(rutas.some(function (ruta) { return String(ruta.envioId) === envioId; })).to.eql(true); });"
                ]
              }
            }
          ],
          "description": "Confirma que el token del repartidor ve sus rutas asignadas."
        },
        {
          "name": "03.5 Iniciar Reparto (Repartidor Asignado)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{repartidor_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "url": "{{gateway_url}}/envios/{{id_envio}}/inicio"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
