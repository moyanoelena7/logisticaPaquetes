{
  "realm": "logistica",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "ADMINISTRADOR", "description": "Gestiona paquetes, flota, envios y rutas" },
      { "name": "REPARTIDOR", "description": "Consulta rutas asignadas y registra entregas" },
      { "name": "MS-LOGISTICA", "description": "Cuenta técnica de ms-logistica para consumir la API interna de ms-paquetes" }
    ]
  },
  "clients": [
    {
      "clientId": "logistica-api",
      "name": "Logistica API (Postman y pruebas)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "ms-logistica-service",
      "name": "Cuenta técnica ms-logistica",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": false
    }
  ],
  "users": [
    {
      "username": "admin.logistica",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Logistica",
      "email": "admin@logistica.local",
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["ADMINISTRADOR"]
    },
    {
      "username": "repartidor.logistica",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Repartidor",
      "lastName": "Logistica",
      "email": "repartidor@logistica.local",
      "credentials": [{ "type": "password", "value": "repartidor123", "temporary": false }],
      "realmRoles": ["REPARTIDOR"]
    },
    {
      "username": "service-account-ms-logistica-service",
      "enabled": true,
      "serviceAccountClientId": "ms-logistica-service",
      "realmRoles": ["MS-LOGISTICA"]
    }
  ]
}
