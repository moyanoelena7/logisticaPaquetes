# MariaDB de ms-paquetes
PAQUETES_DB_ROOT_PASSWORD=cambiar_root_paquetes
PAQUETES_DB_USER=paquetes_app
PAQUETES_DB_PASSWORD=cambiar_password_paquetes

# MariaDB de ms-logistica
LOGISTICA_DB_ROOT_PASSWORD=cambiar_root_logistica
LOGISTICA_DB_USER=logistica_app
LOGISTICA_DB_PASSWORD=cambiar_password_logistica

# Keycloak
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=cambiar_admin_keycloak
# Cliente tecnico usado por ms-logistica para llamar a ms-paquetes
MS_PAQUETES_CLIENT_ID=ms-logistica-service
MS_PAQUETES_CLIENT_SECRET=reemplazar_por_el_secret_configurado_en_keycloak
# URL interna de ms-paquetes para ms-logistica y el gateway dentro de Docker
MS_PAQUETES_URL=http://ms-paquetes:8081
